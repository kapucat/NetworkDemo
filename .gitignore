# Public source-only repository. Keep local Unity assets out of Git.
*
!*/
!/.gitignore
!/.gitattributes
!/README.md
!/Assets/Scripts/**/*.cs
!/Assets/Common共通/Scripts/**/*.cs
!/Assets/ランキングシステムのアクションゲーム/Scripts/**/*.cs
!/Assets/大規模多人数同時参加型オンラインゲーム/MMO-Scripts/**/*.cs
!/Assets/大規模多人数同時参加型オンラインゲーム/MMO-Textures/MoveClickMarker.shader
!/server/**/*.go
!/server/go.mod
!/server/go.sum
!/server/Dockerfile
!/server/docker-compose*.yml
!/server/loadtest/*.js
!/server/loadtest/*.sql
!/server/loadtest/README.md
!/Packages/manifest.json
!/Packages/packages-lock.json
!/ProjectSettings/ProjectVersion.txt
# Local credentials and generated output always stay private.
**/.env
**/.env.*
**/*.pem
**/*.key
**/results/
